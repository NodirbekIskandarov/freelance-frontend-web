# Backend API manzili — brauzerdan chaqiriladi (auth, kabinet, birja).
# `/api/v1` bilan tugashi SHART: endpoint'lar `/api/v1/auth/login/`
# ko'rinishida. Faqat `/api` qoldirilsa har bir so'rov 404 qaytaradi.
#
# Bu manzil brauzerdan chaqirilgani uchun backend CORS ro'yxatida
# saytning domeni bo'lishi kerak (dev uchun http://localhost:3000).
NEXT_PUBLIC_API_URL=https://api.yopamiz.uz/api/v1

# Ochiq katalog (universitet → fan → topshiriq) SERVER tomonda o'qiladi,
# shuning uchun NEXT_PUBLIC_ emas va CORS unga umuman tegishli emas.
CATALOGUE_API_URL=https://api.yopamiz.uz/api/v1



# Saytning haqiqiy manzili — SEO metadata (canonical, OG, sitemap) shundan
# hisoblanadi. Productionda haqiqiy domenga almashtiriladi.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google orqali kirish uchun OAuth client ID (Google Cloud Console).
# Bo'sh qoldirilsa "Google bilan kirish" tugmasi UMUMAN ko'rsatilmaydi —
# ishlamaydigan tugmani chizishdan ko'ra yo'qligi tushunarliroq.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
