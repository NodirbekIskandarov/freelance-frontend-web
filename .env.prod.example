# Serverdagi `.env` uchun namuna (/var/www/yopamiz-front/freelance-frontend-web/.env).
# Bu fayl `docker-compose.prod.yml` tomonidan build args sifatida o'qiladi.
# DIQQAT: NEXT_PUBLIC_* build paytida bundle'ga yoziladi — o'zgartirgandan keyin
# qayta build kerak (deploy workflow `--build` bilan ishga tushadi).

# Backend API manzili (yopamiz-back).
# `/api/v1` bilan tugashi SHART — endpoint'lar `/api/v1/...` ko'rinishida
# (Swagger'ga qarang). Faqat `/api` qoldirilsa har bir so'rov 404 qaytaradi.
NEXT_PUBLIC_API_URL=https://api.yopamiz.uz/api/v1

# Ochiq katalog (universitet → fan → topshiriq) server tomonda o'qiladi.
# NEXT_PUBLIC_ dan alohida: u brauzerga tushmaydi va build paytida ham,
# ISR yangilanishida ham ishlatiladi.
CATALOGUE_API_URL=https://api.yopamiz.uz/api/v1

# Saytning haqiqiy domeni — SEO metadata (canonical, OG, sitemap) shundan olinadi.
NEXT_PUBLIC_APP_URL=https://yopamiz.uz

# Host porti (nginx/reverse proxy shu portga yo'naltiradi).
# 8090 — backend, 8091 — admin panel band qilgan.
WEB_PORT=8092

# Google orqali kirish (ixtiyoriy).
#
# Google Cloud Console → OAuth 2.0 Client ID, turi "Web application".
# Authorized JavaScript origins: https://yopamiz.uz
# Redirect URI kerak EMAS — Identity Services `id_token` beradi.
#
# Bo'sh qoldirilsa login/register sahifalarida Google tugmasi umuman
# chizilmaydi va sayt telefon raqami bilan ishlayveradi.
#
# Backendda ham SHU client id kerak (`GOOGLE_OAUTH_CLIENT_ID`) va u yerda
# qo'shimcha `GOOGLE_TOKEN_VERIFIER` ham qo'yilishi shart — aks holda
# backend tokenni tekshirmay rad qiladi.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
